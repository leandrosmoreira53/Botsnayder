# ============================================================
# .env — Configuração do Bot MM 15m Polymarket
# ============================================================

# --- Auth (Magic e-mail / Proxy) ---
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_PRIVATE_KEY=0xSUA_PRIVATE_KEY_AQUI
POLYMARKET_SIGNATURE_TYPE=1
POLYMARKET_FUNDER=0xSEU_FUNDER_ADDRESS_AQUI

# --- Inputs do mercado (preenchidos pelo discover_tokens.py) ---
TOKEN_ID_YES=
TOKEN_ID_NO=
MARKET_END_TS=0
TICK_SIZE=0.01
MIN_ORDER_SIZE=5

# --- Parâmetros do bot ---
DRY_RUN=true
BASE_ORDER_SIZE=10
MAX_POSITION_SHARES=100
SPREAD_NORMAL=0.04
SPREAD_TIGHT=0.02
SPREAD_FLATTEN=0.01
AMEND_THRESHOLD=0.005
LOOP_INTERVAL_MS=3000

# --- Opcionais (0 = desabilitado) ---
MAX_DAILY_LOSS_USD=0
MAX_BALANCE_UTILIZATION=0
